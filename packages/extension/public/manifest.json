{
  "manifest_version": 3,
  "name": "Gecko for Antigravity",
  "version": "0.6.0",
  "minimum_chrome_version": "116",
  "description": "Independent AI side panel and remote browser companion for Antigravity — read, automate, and control Chrome safely.",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "nativeMessaging", "contextMenus"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gecko for Antigravity",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+G" } }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" }
}
